{
    "name": "wilkques/filesystem",
    "description": "PHP Filesystem",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=5.3",
        "wilkques/container": "*",
        "wilkques/php-helper": ">=5.13.0"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "Wilkques\\Filesystem\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wilkques\\Filesystem\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "*"
    }
}
